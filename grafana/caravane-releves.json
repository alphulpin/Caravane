            "uid": "${DS_SUPABASE}"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select coalesce(mesure_le, recu_le) as \"heure\", coalesce(nom, appareil) as \"carte\", releve_id as \"n°\", source,\n  case when secteur then 'secteur' else 'batterie' end as \"alim.\",\n  temp_c as \"°C\", hum_pct as \"% HR\", press_hpa as \"hPa\", eco2_ppm as \"CO2 éq.\",\n  tvoc_ppb as \"COV\", vbat_mv as \"LiPo mV\", recu_le as \"reçu le\"\nfrom caravane_mesures\nwhere appareil in ($carte) and $__timeFilter(coalesce(mesure_le, recu_le))\norder by 1 desc\nlimit 200"

{
  "__inputs": [
    {
      "name": "DS_SUPABASE",
      "label": "Supabase (PostgreSQL)",
      "description": "Base Supabase du projet caravane",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "grafana-postgresql-datasource",
      "name": "PostgreSQL",
      "version": "1.0.0"
    },
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    }
  ],
  "title": "Caravane — relevés",
  "uid": "caravane-releves",
  "description": "Relevés des cartes caravane (dépôt alphulpin/Caravane)",
  "tags": [
    "caravane"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5m",
  "time": {
    "from": "now-2d",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 2,
  "templating": {
    "list": [
      {
        "name": "carte",
        "label": "Carte",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${DS_SUPABASE}"
        },
        "query": "select coalesce(nom, appareil) as __text, appareil as __value from caravane_cartes order by 1",
        "definition": "select coalesce(nom, appareil) as __text, appareil as __value from caravane_cartes order by 1",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 0
      },
      {
        "name": "grandeur",
        "label": "Grandeur",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${DS_SUPABASE}"
        },
        "query": "select libelle || coalesce(' (' || unite || ')', '') as __text, code as __value\nfrom caravane_grandeurs g\nwhere exists (select 1 from caravane_releves r where r.valeurs ? g.code)\norder by ordre",
        "definition": "select libelle || coalesce(' (' || unite || ')', '') as __text, code as __value\nfrom caravane_grandeurs g\nwhere exists (select 1 from caravane_releves r where r.valeurs ? g.code)\norder by ordre",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Dernières valeurs",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SUPABASE}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 18,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SUPABASE}"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select distinct on (appareil, grandeur)\n  nom || ' · ' || libelle || coalesce(' (' || unite || ')', '') as \"grandeur\", valeur\nfrom caravane_series\nwhere appareil in ($carte) and grandeur in ($grandeur)\norder by appareil, grandeur, mesure_le desc"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^valeur$/",
          "values": true
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "showPercentChange": false
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Dernier relevé",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SUPABASE}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SUPABASE}"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select coalesce(nom, appareil) as carte, extract(epoch from max(coalesce(mesure_le, recu_le))) * 1000 as \"dernier relevé\"\nfrom caravane_releves\nwhere appareil in ($carte)\ngroup by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "${grandeur:text}",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SUPABASE}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SUPABASE}"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select mesure_le as time, nom as metric, valeur as value\nfrom caravane_series\nwhere appareil in ($carte) and grandeur = '$grandeur' and $__timeFilter(mesure_le)\norder by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "spanNulls": 3600000,
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "repeat": "grandeur",
      "repeatDirection": "h",
      "maxPerRow": 2
    },
    {
      "id": 4,
      "type": "state-timeline",
      "title": "Alimentation",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SUPABASE}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SUPABASE}"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select coalesce(mesure_le, recu_le) as time, coalesce(nom, appareil) as metric,\n  case when secteur then 1 else 0 end as value\nfrom caravane_releves\nwhere appareil in ($carte) and secteur is not null and $__timeFilter(coalesce(mesure_le, recu_le))\norder by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Batterie",
                  "color": "orange"
                },
                "1": {
                  "text": "Secteur",
                  "color": "green"
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Derniers relevés",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SUPABASE}"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SUPABASE}"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select coalesce(mesure_le, recu_le) as \"heure\", coalesce(nom, appareil) as \"carte\", releve_id as \"n°\", source,\n  case when secteur then 'secteur' else 'batterie' end as \"alim.\",\n  valeurs::text as \"valeurs\", recu_le as \"reçu le\"\nfrom caravane_releves\nwhere appareil in ($carte) and $__timeFilter(coalesce(mesure_le, recu_le))\norder by 1 desc\nlimit 200"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Configuration publiée (démarrages, changements, battement quotidien)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SUPABASE}"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SUPABASE}"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select k.recu_le as \"reçu le\", coalesce(nullif(k.config->>'nom', ''), k.appareil) as \"carte\",\n  k.evenement as \"événement\", k.config->>'cause' as \"cause\", k.config->>'firmware' as \"firmware\",\n  k.config->>'comm' as \"comm.\", (k.config->>'releve_s')::int / 60 as \"relevé (min)\",\n  (select string_agg(e.key || ' ×' || (e.value->>'pente') || ' ' || (e.value->>'decalage'), ', ' order by e.key)\n     from jsonb_each(k.config->'etalonnage') e\n    where (e.value->>'pente')::float <> 1 or (e.value->>'decalage')::float <> 0) as \"étalonnage (≠ défaut)\"\nfrom caravane_config k\nwhere k.appareil in ($carte) and $__timeFilter(k.recu_le)\norder by k.recu_le desc\nlimit 100"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Configuration",
        "enable": true,
        "iconColor": "purple",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${DS_SUPABASE}"
        },
        "target": {
          "refId": "Anno",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select recu_le as time, coalesce(nullif(config->>'nom', ''), appareil) || ' : ' || evenement as text\nfrom caravane_config\nwhere appareil in ($carte) and evenement <> 'periodique' and $__timeFilter(recu_le)"
        }
      }
    ]
  }
}